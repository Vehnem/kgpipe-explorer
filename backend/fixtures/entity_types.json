  "discovery_query": "PREFIX kgo: <http://github.com/ScaDS/kgpipe/>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\nCONSTRUCT {\n  ?entity a ?type .\n  ?entity rdfs:label ?label .\n}\nWHERE {\n  VALUES ?type {\n    kgo:Task\n    kgo:TaskRun\n    kgo:Implementation\n    kgo:Pipeline\n    kgo:PipelineRun\n    kgo:ConfigSpec\n    kgo:Parameter\n    kgo:Metric\n    kgo:MetricRun\n    kgo:MeasurementSpec\n  }\n  ?entity a ?type .\n  OPTIONAL { ?entity rdfs:label ?rdfsLabel . }\n  OPTIONAL { ?entity kgo:name ?name . }\n  BIND(COALESCE(?rdfsLabel, ?name) AS ?label)\n}"
}
